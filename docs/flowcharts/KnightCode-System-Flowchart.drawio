;Attempts, mistakes, time, lines and best results&#10;First completion earns the level XP&#10;Update the activity log and streak" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#183247;fillColor=#e9f6ef;strokeColor=#567084;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="830" y="837" width="370" height="115" /></mxCell><mxCell id="saved" value="Return saved progress to the browser&#10;Game continues or student changes page" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#183247;fillColor=#eaf4ff;strokeColor=#567084;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="830" y="994" width="370" height="61" /></mxCell><mxCell id="reports" value="On later page loads&#10;Student progress / dashboard&#10;Teacher monitoring / reports&#10;Admin results&#10;read the stored records" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#183247;fillColor=#eaf4ff;strokeColor=#567084;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="800" width="270" height="112" /></mxCell><mxCell id="note0" value="Leaving the game page asks Unity to quit and release the game." style="text;align=left;fontFamily=Arial;fontSize=16;fontColor=#567084;" vertex="1" parent="1"><mxGeometry as="geometry" x="80" y="1039" width="467.1796875" height="24" /></mxCell><mxCell id="note1" value="Temporary failures stay queued" style="text;align=left;fontFamily=Arial;fontSize=15;fontColor=#567084;" vertex="1" parent="1"><mxGeometry as="geometry" x="1245" y="497" width="220.9375" height="23" /></mxCell><mxCell id="note2" value="for retry while the bridge remains loaded." style="text;align=left;fontFamily=Arial;fontSize=15;fontColor=#567084;" vertex="1" parent="1"><mxGeometry as="geometry" x="1245" y="519" width="281.8017578125" height="23" /></mxCell><mxCell id="note3" value="S = the same event continues here." style="text;align=left;fontFamily=Arial;fontSize=15;fontColor=#567084;" vertex="1" parent="1"><mxGeometry as="geometry" x="1260" y="1002" width="246.396484375" height="23" /></mxCell><mxCell id="note4" value="Dashed arrows = data or background flow." style="text;align=left;fontFamily=Arial;fontSize=15;fontColor=#567084;" vertex="1" parent="1"><mxGeometry as="geometry" x="1260" y="1025" width="292.23876953125" height="23" /></mxCell></root></mxGraphModel></diagram></mxfile>