m" value="Choose a task&#10;Manage classes, students and imports&#10;Assign lessons / levels; post announcements&#10;Monitor students; view / export reports&#10;Reset student passwords; edit own profile" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#183247;fillColor=#ffffff;strokeColor=#567084;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="510" width="400" height="147" /></mxCell><mxCell id="am" value="Choose a task&#10;Manage users, classes, lessons and levels&#10;Review results and audit history&#10;Import teachers; change system settings&#10;Back up, restore or clear selected data" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#183247;fillColor=#ffffff;strokeColor=#567084;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1125" y="510" width="400" height="147" /></mxCell><mxCell id="guard" value="Next.js server checks the request&#10;Sign-in, role, input and access to the record" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#183247;fillColor=#eaf4ff;strokeColor=#567084;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="722" width="460" height="56" /></mxCell><mxCell id="allowed" value="Allowed&#10;and valid?" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fontColor=#183247;fillColor=#fff4d8;strokeColor=#567084;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="700" y="805" width="200" height="104" /></mxCell><mxCell id="error" value="Show error / deny request&#10;Do not perform the action" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=17;fontColor=#183247;fillColor=#fff0ee;strokeColor=#567084;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="335" y="825" width="240" height="65" /></mxCell><mxCell id="returnError" value="R" style="ellipse;whiteSpace=wrap;html=0;fontFamily=Arial