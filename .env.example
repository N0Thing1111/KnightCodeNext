# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server only. Never prefix this with NEXT_PUBLIC and never commit its value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY


# Server-only SMTP settings for student welcome and password-reset emails.
# For Gmail, use an App Password rather than the normal account password.
KC_MAIL_SMTP_HOST=smtp.gmail.com
KC_MAIL_SMTP_PORT=587
KC_MAIL_SMTP_USERNAME=your-school-email@gmail.com
KC_MAIL_SMTP_PASSWORD=your-google-app-password
KC_MAIL_FROM_ADDRESS=your-school-email@gmail.com
KC_MAIL_FROM_NAME=KnightCode

# Public origin used in email sign-in links. Set this to the deployed Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only weekly backups. Generate two DIFFERENT random secrets (32+ characters).
# Configure these in Vercel Production and redeploy. Never use NEXT_PUBLIC_ prefixes.
CRON_SECRET=
AUTOMATIC_BACKUP_SECRET=
# Preserve AUTOMATIC_BACKUP_SECRET: existing stored backups need that original key.
